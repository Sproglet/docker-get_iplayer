#!/bin/sh
# Stage and patch updates before replacing the installed files.
(
    set -eu
    workdir=$(mktemp -d)
    trap 'rm -rf "$workdir"' EXIT HUP INT TERM
    old=$(get_iplayer -V 2>&1 | sed -n 's/^get_iplayer v\([0-9.]*\).*/\1/p')
    [ -n "$old" ]
    wget -qO "$workdir/latest.json" "https://api.github.com/repos/get-iplayer/get_iplayer/releases/latest"
    new=$(jq -er .tag_name "$workdir/latest.json")
    new=${new#v}
    # Compare versions numerically, including future multi-digit components.
    if ! perl -Mversion -e 'exit !(version->parse("v".$ARGV[0]) < version->parse("v".$ARGV[1]))' "$old" "$new"; then
        exit 0
    fi
    echo "Updating get_iplayer $old -> $new" >&2
    wget -qO "$workdir/source.tar.gz" "$(jq -er .tarball_url "$workdir/latest.json")"
    mkdir "$workdir/source"
    tar -xzf "$workdir/source.tar.gz" --strip-components=1 -C "$workdir/source"
    /usr/local/bin/patch-get-iplayer "$workdir/source"
    perl -c "$workdir/source/get_iplayer"
    perl -c "$workdir/source/get_iplayer.cgi"
    install -m 755 -t /usr/local/bin "$workdir/source/get_iplayer" "$workdir/source/get_iplayer.cgi"
    # Restart the web front-end as before, leaving background PVR jobs alone.
    pids=$(ps | awk '/[\/]usr\/local\/bin\/get_iplayer.cgi/ {print $1}')
    [ -z "$pids" ] || kill $pids
) 2>> /var/log/get_iplayer_update.log

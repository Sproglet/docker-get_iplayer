#!/bin/sh
set -eu
umask 002
case "$PUID" in ''|*[!0-9]*|0) echo "PUID must be a non-root numeric UID" >&2; exit 1;; esac
case "$PGID" in ''|*[!0-9]*) echo "PGID must be numeric" >&2; exit 1;; esac
if ! [ "$PUID" -ge 1 ] || ! [ "$PUID" -le 4294967294 ]; then
    echo "PUID must be a non-root numeric UID in the range 1..4294967294" >&2
    exit 1
fi
if ! [ "$PGID" -ge 0 ] || ! [ "$PGID" -le 4294967294 ]; then
    echo "PGID must be in the range 0..4294967294" >&2
    exit 1
fi
# Only initialise a new/empty output directory; never recursively chown recordings.
mkdir -p "$GETIPLAYER_OUTPUT"
if [ -z "$(ls -A "$GETIPLAYER_OUTPUT")" ]; then
    chown "$PUID:$PGID" "$GETIPLAYER_OUTPUT"
    chmod 2775 "$GETIPLAYER_OUTPUT"
fi
export HOME="$GETIPLAYER_OUTPUT"
if [ "$#" -gt 0 ]; then
    exec su-exec "$PUID:$PGID" "$@"
fi
exec su-exec "$PUID:$PGID" /usr/local/lib/get_iplayer/app.py
